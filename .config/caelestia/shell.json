{
    "appearance": {
        "font": {
            "body": {
                "family": "Google Sans"
            },
            "clock": "Google Sans",
            "headline": {
                "family": "Google Sans"
            },
            "label": {
                "family": "Google Sans"
            },
            "title": {
                "family": "Google Sans"
            },
            "workspaces": "Google Sans"
        },
        "transparency": {
            "enabled": true
        }
    },
    "background": {
        "wallpaperEnabled": true
    },
    "bar": {
        "activeWindow": {
            "compact": false,
            "inverted": false,
            "showOnHover": true
        },
        "clock": {
            "background": true,
            "showDate": true
        },
        "persistent": false,
        "popouts": {
            "activeWindow": true
        },
        "scrollActions": {
            "volume": true,
            "workspaces": true
        },
        "showOnHover": true,
        "statusIcons": [
            {
                "enabled": true,
                "id": "audio"
            },
            {
                "enabled": true,
                "id": "battery"
            },
            {
                "enabled": false,
                "id": "bluetooth"
            },
            {
                "enabled": true,
                "id": "kbLayout"
            },
            {
                "enabled": false,
                "id": "lockStatus"
            },
            {
                "enabled": false,
                "id": "microphone"
            },
            {
                "enabled": false,
                "id": "network"
            }
        ],
        "tray": {
            "background": false,
            "compact": true,
            "recolour": true
        },
        "workspaces": {
            "activeIndicator": true,
            "activeTrail": true,
            "maxWindowIcons": 5,
            "occupiedBg": false,
            "perMonitorWorkspaces": true,
            "showWindows": false,
            "showWindowsOnSpecialWorkspaces": true,
            "shown": 5
        }
    },
    "dashboard": {
        "dragThreshold": 40
    },
    "general": {
        "apps": {
            "audio": [
                "pavucontrol"
            ],
            "explorer": [
                "nautilus"
            ],
            "terminal": [
                "kitty"
            ]
        }
    },
    "launcher": {
        "enableDangerousActions": true,
        "showOnHover": false,
        "useFuzzy": {
            "actions": true,
            "apps": true,
            "schemes": true,
            "variants": true,
            "wallpapers": true
        }
    },
    "services": {
        "useFahrenheit": false
    },
    "sidebar": {
        "enabled": true
    },
    "utilities": {
        "toasts": {
            "nowPlaying": true
        }
    }
}
