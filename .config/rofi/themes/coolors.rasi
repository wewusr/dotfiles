/* Coolors palette: 0C1434 F0B08E 0B0512 ED895B 304976 */

* {
    bg:        #0C1434;
    bg-alt:    #0B0512;
    fg:        #F0B08E;
    accent:    #ED895B;
    sel-bg:    #304976;

    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 800px;
    location: center;
    anchor: center;
    border-radius: 18px;
    border: 2px;
    border-color: @sel-bg;
    background-color: rgba(12, 20, 52, 25%);
    padding: 14px;
}

mainbox {
    background-color: transparent;
    padding: 0;
    spacing: 12px;
    children: [ mode-switcher, inputbar, listview, message ];
}

inputbar {
    background-color: @bg-alt;
    border-radius: 12px;
    padding: 12px 16px;
    spacing: 12px;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @accent;
    font: "FiraCode Nerd Font Mono Bold 13";
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder-color: rgba(240, 176, 142, 0.35);
    font: "FiraCode Nerd Font Mono 13";
}

listview {
    background-color: transparent;
    padding: 4px 2px;
    spacing: 6px;
    lines: 8;
    columns: 1;
    cycle: true;
    scrollbar: true;
}

element {
    background-color: transparent;
    padding: 12px 14px;
    border-radius: 10px;
    text-color: @fg;
}

element selected {
    background-color: @sel-bg;
    text-color: @fg;
    border: 1px;
    border-color: @accent;
}

element-icon {
    size: 1.1em;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    margin: 0 0 0 8px;
}

scrollbar {
    width: 6px;
    background-color: transparent;
    handle-color: @sel-bg;
    border-radius: 3px;
}

message {
    background-color: transparent;
    border-radius: 10px;
    padding: 10px 14px;
}

message-text {
    text-color: @fg;
}

textbox {
    background-color: transparent;
    text-color: @fg;
}

mode-switcher {
    background-color: transparent;
    spacing: 6px;
    padding: 0 4px;
}

button {
    background-color: transparent;
    text-color: rgba(240, 176, 142, 0.55);
    padding: 8px 14px;
    border-radius: 10px 10px 0 0;
    border: 0px 0px 2px 0px;
    border-color: transparent;
}

button selected {
    background-color: transparent;
    text-color: @accent;
    border: 0px 0px 2px 0px;
    border-color: @accent;
}

button focused {
    background-color: @bg-alt;
    text-color: @accent;
}
