{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 4,
  "margin-top": 0,
  "margin-bottom": 0,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "cpu",
    "memory",
    "disk",
    "custom/keyboard-layout",
    "battery"
  ],

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "sort-by-number": true
  },

  "clock": {
    "format": "<span color='#ED895B'></span>  {:%A, %B %d  %I:%M:%S %p}",
    "interval": 1,
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<span color='#ED895B'><b>{}</b></span>",
        "weekdays-header": "<span color='#304976'>{}</span>",
        "today": "<span color='#0B0512' background='#F0B08E'><b>{}</b></span>"
      }
    }
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span color='#ED895B'>{icon}</span> {capacity}%",
    "format-warning": "<span color='#ED895B'>{icon}</span> {capacity}%",
    "format-critical": "<span color='#ED895B'>{icon}</span> {capacity}%",
    "format-charging": "<span color='#ED895B'>󰂄</span> {capacity}%",
    "format-plugged": "<span color='#ED895B'>󱘖</span> {capacity}%",
    "format-full": "<span color='#ED895B'>󰁹</span> {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo} · {power}W · {time}"
  },

  "cpu": {
    "format": "<span color='#ED895B'>󰍛</span> {usage}%",
    "tooltip-format": "Load: {load} · {usage}%"
  },

  "memory": {
    "format": "<span color='#ED895B'></span> {percentage}%",
    "tooltip-format": "{used} GB / {total} GB · {percentage}%"
  },

  "disk": {
    "format": "<span color='#ED895B'>󰋊</span> {percentage_free}%",
    "tooltip-format": "{used} GB free of {total} GB"
  },

  "custom/keyboard-layout": {
    "exec": "/home/wewusr/.config/waybar/scripts/keyboard-layout.sh",
    "format": "<span color='#ED895B'></span> {}",
    "on-click": "hyprctl switchxkblayout all next",
    "tooltip": false
  },

  "tray": {
    "icon-size": 16,
    "spacing": 6
  }
}
